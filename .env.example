# ===== Server =====
PORT=5000
CORS_ORIGIN=https://nexwapi.com,https://www.nexwapi.com,https://app.nexwapi.com
# NODE_ENV=production

# ===== Database =====
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB

# ===== Auth =====
JWT_SECRET=change_me_to_a_long_random_string_32plus_chars

# ===== Admin (seeded on boot) =====
ADMIN_EMAIL=admin@nexwapi.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=Admin

# ===== Razorpay =====
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ===== WhatsApp Cloud API =====
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=nexwapi_verify_change_me
WHATSAPP_CONFIG_ID=
PUBLIC_API_URL=https://api.nexwapi.com
WHATSAPP_REDIRECT_URI=https://app.nexwapi.com/dashboard/whatsapp
# 6-digit PIN for Cloud API phone registration (set during onboarding; default 123456)
WHATSAPP_REGISTER_PIN=123456

# Partner billing — Nexwapi pays Meta; clients never add card/currency
META_PARTNER_BUSINESS_ID=
META_CREDIT_LINE_ID=
WHATSAPP_CREDIT_LINE_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
WHATSAPP_BILLING_CURRENCY=INR
WHATSAPP_BUSINESS_ID=

# Platform messaging number shown in Super Admin (E.164 without + is fine)
PLATFORM_MESSAGING_PHONE=917631100654
# Optional: dedicated company id for platform WhatsApp inbox (auto-created if empty)
# PLATFORM_COMPANY_ID=

# ===== Email — From = no-reply; Support = separate =====
MAIL_FROM=no-reply@nexwapi.com
MAIL_FROM_NAME=Nexwapi
MAIL_SUPPORT=hello@nexwapi.com
APP_URL=https://nexwapi.com
# EMAIL_PROVIDER=auto

# ZeptoMail API (recommended on production — HTTPS :443)
ZEPTOMAIL_TOKEN=paste_send_mail_token_here
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email

# ZeptoMail SMTP backup (VMs often block 587/465)
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=same_send_mail_token_as_password
SMTP_DISABLED=true
