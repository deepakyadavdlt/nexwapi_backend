// Prisma schema — multi-tenant Nexwapi SaaS (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  AGENT
  MEMBER
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

// Plan keys used in billing + feature gates
enum PlanKey {
  trial
  starter
  growth
  professional
  enterprise
  expired
}

model Company {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  email          String?
  phone          String?
  website        String?
  status         CompanyStatus @default(TRIAL)
  plan           PlanKey       @default(trial)
  trialEndsAt    DateTime?
  trialStartedAt DateTime?
  upgradedAt     DateTime?
  suspendedAt    DateTime?
  suspendReason  String?
  lastActiveAt   DateTime?
  chatbotUsed    Boolean       @default(false)
  // Wallet & messaging credits (1 credit ≈ 1 outbound message by default)
  walletBalancePaise Int       @default(0) // rupees stored as paise
  messageCredits     Int       @default(500) // trial starter credits
  freeAccess         Boolean   @default(false) // Super Admin grant — no payment required
  freeAccessNote     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users            User[]
  payments         Payment[]
  subscription     Subscription?
  whatsappAccounts WhatsAppAccount[]
  agents           Agent[]
  teams            Team[]
  rolePermissions  RolePermission[]
  contacts         Contact[]
  messages         Message[]
  templates        Template[]
  campaigns        Campaign[]
  automations      Automation[]
  flows            Flow[]
  whatsAppForms    WhatsAppForm[]
  interactiveLists InteractiveList[]
  drips            Drip[]
  segments         Segment[]
  products         Product[]
  commerceSetting  CommerceSetting?
  catalogCollections CatalogCollection[]
  commerceOrders   CommerceOrder[]
  integrations     Integration[]
  labels           Label[]
  assignmentRules  AssignmentRule[]
  apiKeys          ApiKey[]
  setting          Setting?
  couponsRedemptions CouponRedemption[]
  usage            Usage[]
  auditLogs        AuditLog[]
  tickets          Ticket[]
  walletTxns       WalletTransaction[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String?
  phone        String?
  role         UserRole  @default(OWNER)
  isActive     Boolean   @default(true)
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lastLoginAt  DateTime?
  lastActiveAt DateTime?
  permissions  Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]
  tickets      Ticket[]  @relation("TicketUser")

  @@index([companyId])
}

model Subscription {
  id           String   @id @default(cuid())
  companyId    String   @unique
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan         PlanKey  @default(trial)
  status       String   @default("active") // active | cancelled | past_due
  trialEndsAt  DateTime?
  activatedAt  DateTime?
  expiresAt    DateTime?
  amount       Int      @default(0) // paise
  currency     String   @default("INR")
  billingCycle String   @default("monthly")
  autoRenew    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Plan {
  id            String   @id @default(cuid())
  key           PlanKey  @unique
  name          String
  amount        Int // paise
  currency      String   @default("INR")
  inbox         Boolean  @default(true)
  campaign      Boolean  @default(true)
  chatbot       Boolean  @default(true)
  automation    Boolean  @default(true)
  api           Boolean  @default(false)
  unlimitedAgents Boolean @default(false)
  agentLimit    Int      @default(3)
  contactLimit  Int      @default(1000)
  messageLimit  Int      @default(5000)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WhatsAppAccount {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessId         String?
  wabaId             String?
  phoneNumberId      String?
  phoneNumber        String?
  displayPhoneNumber String?
  businessName       String?
  verifiedName       String?
  accessToken        String?
  refreshToken       String?
  tokenExpiresAt     DateTime?
  qualityRating      String? // GREEN | YELLOW | RED | UNKNOWN
  messagingLimit     String? // TIER_1K | TIER_10K | TIER_100K | UNLIMITED
  verificationStatus String? // verified | unverified | pending
  webhookStatus      String   @default("pending") // pending | connected | error
  status             String   @default("disconnected") // connected | disconnected | error
  isConnected        Boolean  @default(false)
  isDefault          Boolean  @default(true)
  verifyToken        String?
  appSecret          String?
  lastWebhookAt      DateTime?
  lastSyncAt         DateTime?
  lastError          String?
  connectedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyId])
  @@index([phoneNumberId])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan              PlanKey  @default(growth)
  type              String   @default("plan") // plan | wallet_recharge | admin_grant
  amount            Int // paise
  currency          String   @default("INR")
  status            String   @default("created") // created | pending | paid | failed | refunded
  creditsAdded      Int      @default(0)
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  invoiceNo         String?
  couponCode        String?
  refundId          String?
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([type])
}

// Money in/out of client wallet + message credit ledger
model WalletTransaction {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         String // credit | debit
  reason       String // recharge | plan | admin_grant | message_send | message_recv | adjust
  amountPaise  Int      @default(0) // wallet money change (+/-)
  creditsDelta Int      @default(0) // message credits change (+/-)
  balanceAfter Int      @default(0) // walletBalancePaise after txn
  creditsAfter Int      @default(0) // messageCredits after txn
  meta         Json?
  createdBy    String? // userId or "system"
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
}

// Global SaaS pricing (Super Admin editable)
model PlatformSetting {
  id                String   @id @default("default")
  // How many message credits ₹1 (100 paise) buys
  creditsPerRupee   Int      @default(10)
  // Credits charged per outbound / inbound message
  creditPerOutbound Int      @default(1)
  creditPerInbound  Int      @default(0)
  trialCredits      Int      @default(500)
  starterCredits    Int      @default(5000)
  growthCredits     Int      @default(20000)
  updatedAt         DateTime @updatedAt
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String   @default("")
  discountPct   Int      @default(0) // 0-100
  freeDays      Int      @default(0) // e.g. FREE30
  planKey       PlanKey? // optional: only for a specific plan
  maxRedemptions Int?
  redeemedCount Int      @default(0)
  active        Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  redemptions   CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, companyId])
}

model Usage {
  id             String  @id @default(cuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messagesSent   Int     @default(0)
  messagesRecv   Int     @default(0)
  campaignsCount Int     @default(0)
  apiCalls       Int     @default(0)
  month          Int
  year           Int

  @@unique([companyId, month, year])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}

model Ticket {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation("TicketUser", fields: [userId], references: [id], onDelete: SetNull)
  subject    String
  body       String   @default("")
  adminReply String   @default("")
  origin     String   @default("client") // client | admin
  status     String   @default("open") // open | pending | closed
  priority   String   @default("normal")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  audience  String   @default("client") // client | admin
  userId    String?
  companyId String?
  title     String
  body      String   @default("")
  href      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([audience, createdAt])
  @@index([companyId, createdAt])
  @@index([userId, read])
}

model SalesLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  company   String   @default("")
  message   String
  status    String   @default("new")
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  agents    Agent[]

  @@unique([companyId, name])
  @@index([companyId])
}

/** Per-workspace RBAC matrix for a display role (Owner, Admin, Teammate…). */
model RolePermission {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        String
  permissions Json     @default("{}")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([companyId, role])
  @@index([companyId])
}

model Agent {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  firstName    String    @default("")
  lastName     String    @default("")
  email        String
  phone        String    @default("")
  role         String    @default("Teammate")
  /// inbox | sales — used for All Agents vs Sales CRM Agents tabs
  kind         String    @default("inbox")
  color        String    @default("#25D366")
  availability String    @default("online") // online | away | offline
  inviteStatus String    @default("pending") // pending | joined
  createdBy    String    @default("")
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  contacts     Contact[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([teamId])
}

model Note {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  text      String
  author    String   @default("You")
  createdAt DateTime @default(now())

  @@index([contactId])
}

model Contact {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  email           String?
  userId          String?
  tags            String[]  @default([])
  optedIn         Boolean   @default(true)
  color           String    @default("#25D366")
  createdAt       DateTime  @default(now())
  messages        Message[]
  notes           Note[]
  assignedAgent   Agent?    @relation(fields: [assignedAgentId], references: [id])
  assignedAgentId String?
  activeFlowId    String?
  activeFlowStep  String?
  attributes      Json      @default("{}")
  chatStatus      String    @default("open")
  labels          String[]  @default([])

  @@unique([companyId, phone])
  @@index([companyId])
}

model Event {
  id        String   @id @default(cuid())
  contactId String
  type      String
  text      String
  createdAt DateTime @default(now())

  @@index([contactId])
}

model Label {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#25D366")
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

model Drip {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean          @default(true)
  steps       Json             @default("[]")
  createdAt   DateTime         @default(now())
  enrollments DripEnrollment[]

  @@index([companyId])
}

model DripEnrollment {
  id          String   @id @default(cuid())
  drip        Drip     @relation(fields: [dripId], references: [id], onDelete: Cascade)
  dripId      String
  contactId   String
  currentStep Int      @default(0)
  nextAt      DateTime
  status      String   @default("active")
  createdAt   DateTime @default(now())

  @@index([status, nextAt])
}

model Segment {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  tags        String[] @default([])
  match       String   @default("any")
  filters     Json?    // { type: "tags"|"fields"|"events", conditions: [...] }
  whatsappOnly Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  price       String   @default("")
  description String   @default("")
  imageUrl    String   @default("")
  retailerId  String   @default("") // Meta product retailer_id
  currency    String   @default("INR")
  availability String  @default("in stock")
  source      String   @default("local") // local | meta | sample | csv
  collectionMetaId String @default("")
  metaProductId String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, retailerId])
}

/** Per-tenant WhatsApp Commerce / Catalog settings (Interakt-style). */
model CommerceSetting {
  id                    String    @id @default(cuid())
  companyId             String    @unique
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  catalogId             String    @default("")
  catalogName           String    @default("")
  connectedAt           DateTime?
  lastSyncAt            DateTime?
  sandboxMode           Boolean   @default(true)
  partnerAccessGranted  Boolean   @default(false)
  collectionsBody       String    @default("Hey there, check out our top product collections")
  collectionsButton     String    @default("View Collections")
  catalogInCampaigns    Boolean   @default(false)
  catalogInAutoReplies  Boolean   @default(false)
  autocheckoutEnabled   Boolean   @default(false)
  autocheckoutFlowId    String    @default("")
  paymentLinkBase       String    @default("")
  shippingPrompt        String    @default("Thanks for your cart! Please share your full shipping address (name, street, city, pincode, phone).")
  paymentPrompt         String    @default("Great — here is your payment link. Once paid, we will confirm your order.")
  orderConfirmMessage   String    @default("Your order is confirmed! We will update you when it ships.")
  // Autocheckout workflow (Interakt-style)
  shippingMode          String    @default("free") // free | fixed | threshold
  shippingAmount        String    @default("0") // rupees as string
  freeShippingAbove     String    @default("2000")
  discountEnabled       Boolean   @default(false)
  discountType          String    @default("none") // none | percent | flat
  discountValue         String    @default("0")
  paymentMethod         String    @default("cod") // cod | link | both
  proceedMessage        String    @default("Thanks for your cart! {{shipping_note}} Your total order value is {{total_order_value}}. Would you like to go ahead with the order?")
  askNameMessage        String    @default("Great! We will require some details to ship the order. Please provide your full name.")
  askPincodeMessage     String    @default("Please provide the Pincode/Postcode/Zipcode of the delivery location.")
  askAddressMessage     String    @default("Please enter your street address, building name/number, flat number, floor etc. For example: 123, MG Road, Kusum Apartments, Flat no. 123, 1st floor.")
  confirmOrderMessage   String    @default("Thanks for providing the details! We have noted your address as: {{address}}. {{payment_note}} Would you like to confirm the order?")
  cancelMessage         String    @default("No problem! Your cart is saved. Message us anytime when you are ready to order.")
  shippingConfirmed     Boolean   @default(false)
  discountsConfirmed    Boolean   @default(false)
  paymentConfirmed      Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model CatalogCollection {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metaSetId          String   @default("")
  name               String
  includeInTop10     Boolean  @default(true)
  headerText         String   @default("")
  bodyText           String   @default("")
  footerText         String   @default("")
  imageUrl           String   @default("")
  productCount       Int      @default(0)
  productRetailerIds Json     @default("[]")
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
  @@unique([companyId, metaSetId])
}

model CommerceOrder {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId       String?
  contactPhone    String   @default("")
  contactName     String   @default("")
  waMessageId     String?
  catalogId       String   @default("")
  status          String   @default("enquiry") // legacy pipeline status
  // Interakt-style Order Panel fields
  orderStatus       String @default("cart_received") // cart_received | on_hold | confirmed | cancelled
  paymentStatus     String @default("unpaid") // unpaid | paid | partially_paid
  fulfillmentStatus String @default("not_scheduled") // not_scheduled | scheduled | partially_shipped | shipped | partially_delivered | pending | delivered | cancelled
  currency        String   @default("INR")
  totalAmount     String   @default("0")
  items           Json     @default("[]")
  shippingAddress Json?
  paymentLink     String   @default("")
  notes           String   @default("")
  source          String   @default("whatsapp_cart") // whatsapp_cart | manual | enquiry
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, orderStatus])
  @@index([companyId, paymentStatus])
  @@index([companyId, fulfillmentStatus])
  @@index([contactId])
}

/** Third-party app connections (Interakt-style Integrations). */
model Integration {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider     String   // woocommerce | shopify | google_sheets | facebook_leads | own_api | razorpay | ...
  name         String   @default("")
  status       String   @default("disconnected") // disconnected | connected | error
  config       Json     @default("{}") // credentials / settings (secrets stored here for MVP)
  webhookSecret String  @default("")
  lastSyncAt   DateTime?
  lastError    String   @default("")
  eventCount   Int      @default(0)
  connectedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, provider])
  @@index([companyId])
  @@index([provider, status])
}

model Setting {
  id           String   @id @default(cuid())
  companyId    String   @unique
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  awayEnabled  Boolean  @default(false)
  awayMessage  String   @default("Thanks for messaging! We're away right now and will reply during business hours.")
  hoursStart   Int      @default(9)
  hoursEnd     Int      @default(18)
  days         String[] @default(["Mon", "Tue", "Wed", "Thu", "Fri"])
  businessName String   @default("Nexwapi")
  autoAssign         Boolean  @default(true)
  assignmentMode     String   @default("load_balance") // none | round_robin | load_balance
  assignOnlineOnly   Boolean  @default(false)
  roundRobinIndex    Int      @default(0)
  welcomeEnabled     Boolean  @default(false)
  welcomeMessage     String   @default("Hi! Thanks for reaching out. How can we help you today?")
  delayedEnabled     Boolean  @default(false)
  delayedMinutes     Int      @default(15)
  delayedMessage     String   @default("Thanks for your patience! A team member will reply shortly.")
  customRepliesEnabled Boolean @default(true)
  workingHoursSlots  Json?
  intentMatchingEnabled Boolean @default(false)
  flowFollowUpEnabled   Boolean @default(false)
  flowFollowUpMinutes   Int     @default(30)
  flowFollowUpMessage   String  @default("Hi! Just checking in — would you like to continue?")
  flowIdleTimeoutMinutes Int    @default(60)
  aiAgentEnabled        Boolean @default(false)
  aiAgentWebsiteUrl     String  @default("")
  aiAgentKnowledge      Json?
  aiAgentGreeting       String  @default("Hi! I'm the Nexwapi assistant. How can I help?")
  voiceAiEnabled        Boolean @default(false)
  voiceAiPlan           String  @default("business")
  voiceAiCredits        Int     @default(100)
  webhookUrl         String   @default("")
  /** When true, public Message Send API returns error for opted-out contacts. */
  rejectOptedOutApi  Boolean  @default(true)
  csatEnabled  Boolean  @default(false)
  csatMessage  String   @default("Thanks for chatting with us! How would you rate your experience?")
  updatedAt    DateTime @updatedAt
}

model AssignmentRule {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  trait     String
  condition String   @default("contains")
  values    String[] @default([])
  agentIds  String[] @default([])
  enabled   Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model ApiKey {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  key        String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@unique([companyId, key])
  @@index([companyId])
  @@index([key])
}

model Flow {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  triggerType String   @default("keyword")
  trigger     String   @default("")
  enabled     Boolean  @default(true)
  steps       Json     @default("[]")
  sentCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([companyId])
}

model WhatsAppForm {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  triggerKeyword String @default("")
  fields       Json     @default("[]")
  thankYouMessage String @default("Thanks! We received your details.")
  enabled      Boolean  @default(true)
  submissionCount Int   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model InteractiveList {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  header    String   @default("")
  body      String   @default("")
  footer    String   @default("")
  buttonText String  @default("View options")
  sections  Json     @default("[]")
  enabled   Boolean  @default(true)
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Message {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  waId      String?  @unique
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  direction String
  type      String   @default("text")
  text      String
  mediaUrl  String?
  filename  String?
  status    String   @default("sent")
  senderName String?
  senderUserId String?
  automationSource String?
  at        DateTime @default(now())

  @@index([contactId])
  @@index([companyId])
}

model Template {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  category  String    @default("Utility")
  language  String    @default("en")
  status    String    @default("pending")
  body      String
  format    String    @default("text")
  cards     Json?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
}

model QuickReply {
  id        String   @id @default(cuid())
  companyId String?
  title     String
  text      String
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Automation {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  keyword   String   @default("")
  matchType String   @default("contains")
  reply     String
  enabled   Boolean  @default(true)
  sentCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Campaign {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  template      String
  audience      String    @default("All contacts")
  recipients    Int       @default(0)
  sent          Int       @default(0)
  delivered     Int       @default(0)
  read          Int       @default(0)
  replied       Int       @default(0)
  failed        Int       @default(0)
  status        String    @default("scheduled")
  campaignType  String    @default("onetime")
  category      String?
  scheduledAt   DateTime?
  liveAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([companyId])
  @@index([status])
}
